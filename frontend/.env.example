# Copy to .env.local for local overrides. Never commit real .env files.

# Base URL of the SecureCargo API (no trailing slash). Defaults to http://localhost:8000 when unset.
# `wrangler dev` in backend/worker serves the full API (Worker + container) on http://localhost:8787.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (sign-in, organizations). Development keys from the Clerk dashboard; production keys live in
# the Vercel project settings.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
