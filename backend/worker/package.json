    "typecheck": "wrangler types && tsc --noEmit",
    "check": "wrangler deploy --dry-run"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}
