{
  "name": "securecargo-api-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin Cloudflare Worker that routes api.securecargo.app to the FastAPI container.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "check": "wrangler deploy --dry-run",
    "test": "vitest run",
    "seed:demo": "tsx seed/demo.ts"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@clerk/backend": "^3.31.2",
    "hono": "^4.13.19"
  }
}
