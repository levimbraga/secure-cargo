{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "securecargo-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-18",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	// Public address of the API. The workers.dev URL stays enabled as a second entry point.
	"routes": [
		{
			"pattern": "api.securecargo.app",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	// Demo reset (src/purge.ts): every hour, delete demo inspections older than 24 h.
	"triggers": {
		"crons": ["17 * * * *"]
	},
	"vars": {
		// Browser origins allowed to call the API (comma-separated). Passed to the container.
		"CORS_ORIGINS": "https://securecargo.app,https://www.securecargo.app,http://localhost:3000",
		// Site origin, for links in invitation emails.
		"SITE_URL": "https://securecargo.app"
	},
	// Secrets (never in the repo; `wrangler secret put`, locally in .dev.vars):
	//   CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY, PLATFORM_ADMIN_EMAILS (comma-separated),
	//   ANTHROPIC_API_KEY (photo analysis; without it the analysis answers "demo mode").
	// Records: organizations, users, inspections, results, usage (migrations/).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "securecargo",
			"database_id": "9382939a-e9ac-43b9-b59d-27ad37028382",
			"migrations_dir": "migrations"
		}
	],
	// Inspection photos (EXIF stripped). Private: served only through authorized routes.
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "securecargo-photos"
		}
	],
	// Per-IP limits for anonymous endpoints (Workers rate limiting; period must be 10 or 60 s).
	"ratelimits": [
		{
			"name": "ANON_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "PHYSICS_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			// The battery and the planner run up to 7 and 30 simulations: a tighter limit.
			"name": "BATTERY_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 8, "period": 60 }
		}
	],
	// Identifies the deployed Worker version; used to give every deploy a fresh container.
	"version_metadata": {
		"binding": "VERSION"
	},
	"containers": [
		{
			"class_name": "ApiContainer",
			"scheduling_policy": "durable_object",
			"images": {
				"api": {
					"dockerfile": "../Dockerfile"
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "API_CONTAINER",
				"class_name": "ApiContainer"
			}
		]
	},
	"exports": {
		"ApiContainer": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
